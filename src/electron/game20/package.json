{
    "name": "ps1-runner",
    "version": "1.0.0",
    "description": "Browse, save and run PowerShell (.ps1) scripts",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --win portable",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "author": "",
    "license": "MIT",
    "build": {
        "appId": "com.eiq.ps1runner",
        "productName": "PS1 Runner",
        "win": {
            "target": "portable"
        },
        "files": [
            "main.js",
            "preload.js",
            "renderer.js",
            "index.html"
        ]
    },
    "devDependencies": {
        "electron": "23.1.3",
        "electron-builder": "^24.6.4",
        "electron-packager": "^17.1.2"
    }
}